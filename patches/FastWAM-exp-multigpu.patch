+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+
+
+_MULTIGPU_OVERRIDES = (
+    "EVALUATION.device=cuda:0",
+    "EVALUATION.video_device=cuda:0",
+    "EVALUATION.action_device=cuda:1",
+    "EVALUATION.vae_device=cuda:1",
+    "EVALUATION.text_encoder_device=null",
+    "EVALUATION.text_encoder_devices=[cuda:2,cuda:3]",
+    "EVALUATION.compile_action_infer=false",
+)
+
+
+def _override_key(override: str) -> str:
+    return override.split("=", 1)[0].lstrip("+~")
+
+
+@dataclass(frozen=True)
+class WorkerLaunch:
+    physical_gpus: tuple[str, ...]
+
+    @property
+    def worker_id(self) -> str:
+        if len(self.physical_gpus) == 1:
+            return self.physical_gpus[0]
+        return "group_" + "-".join(self.physical_gpus)
+
+    @property
+    def cuda_visible_devices(self) -> str:
+        return ",".join(self.physical_gpus)
+
+    @property
+    def result_gpu_id(self) -> str:
+        return self.physical_gpus[0]
+
+    @property
+    def component_overrides(self) -> tuple[str, ...]:
+        return _MULTIGPU_OVERRIDES if len(self.physical_gpus) > 1 else ()
+
+    def merge_overrides(self, extra_overrides: Sequence[str]) -> list[str]:
+        if not self.component_overrides:
+            return list(extra_overrides)
+        required = {
+            _override_key(override): override
+            for override in self.component_overrides
+        }
+        forwarded = []
+        for override in extra_overrides:
+            key = _override_key(override)
+            if key not in required:
+                forwarded.append(override)
+                continue
+            if override != required[key]:
+                raise ValueError(
+                    f"Worker group {self.physical_gpus} requires `{required[key]}`, "
+                    f"but received conflicting override `{override}`."
+                )
+        return [*forwarded, *self.component_overrides]
+
+    def build_command(
+        self,
+        *,
+        python_executable: str,
+        config_name: str,
+        task_choice: str,
+        ckpt: str,
+        num_trials: int,
+        output_dir: str,
+        extra_overrides: Sequence[str],
+    ) -> list[str]:
+        return [
+            python_executable,
+            "experiments/libero/eval_libero_single.py",
+            "--config-name",
+            config_name,
+            f"task={task_choice}",
+            f"ckpt={ckpt}",
+            f"gpu_id={self.result_gpu_id}",
+            f"EVALUATION.num_trials={num_trials}",
+            f"EVALUATION.output_dir={output_dir}",
+            *self.merge_overrides(extra_overrides),
+        ]
+
+    def build_environment(
+        self,
+        *,
+        base_environment: Mapping[str, str],
+        pending_file: str,
+        lock_file: str,
+        stop_file: str,
+        status_dir: str,
+        failed_file: str,
+    ) -> dict[str, str]:
+        environment = dict(base_environment)
+        environment.update(
+            {
+                "CUDA_VISIBLE_DEVICES": self.cuda_visible_devices,
+                "LIBERO_WORKER_MODE": "1",
+                "LIBERO_WORKER_ID": self.worker_id,
+                "LIBERO_WORKER_PHYSICAL_GPUS": self.cuda_visible_devices,
+                "LIBERO_WORKER_PENDING_FILE": pending_file,
+                "LIBERO_WORKER_LOCK_FILE": lock_file,
+                "LIBERO_WORKER_STOP_FILE": stop_file,
+                "LIBERO_WORKER_STATUS_DIR": status_dir,
+                "LIBERO_WORKER_FAILED_FILE": failed_file,
+            }
+        )
+        return environment
+
+
+def _available_gpu_ids(num_gpus: int, cuda_visible_devices: str | None) -> list[str]:
+    if num_gpus <= 0:
+        raise ValueError("MULTIRUN.num_gpus must be positive.")
+    if cuda_visible_devices is None:
+        return [str(index) for index in range(num_gpus)]
+
+    entries = [entry.strip() for entry in cuda_visible_devices.split(",")]
+    if not entries or any(not entry for entry in entries):
+        raise ValueError("CUDA_VISIBLE_DEVICES contains an empty GPU identifier.")
+    if len(entries) != len(set(entries)):
+        raise ValueError("CUDA_VISIBLE_DEVICES contains duplicate GPU identifiers.")
+    if len(entries) < num_gpus:
+        raise ValueError(
+            f"MULTIRUN.num_gpus={num_gpus}, but CUDA_VISIBLE_DEVICES only has "
+            f"{len(entries)} entries."
+        )
+    return entries[:num_gpus]
+
+
+def resolve_worker_launches(
+    *,
+    num_gpus: int,
+    gpu_groups: Sequence[Sequence[int | str]] | None,
+    cuda_visible_devices: str | None,
+) -> list[WorkerLaunch]:
+    available = _available_gpu_ids(num_gpus, cuda_visible_devices)
+    if gpu_groups is None:
+        return [WorkerLaunch((gpu_id,)) for gpu_id in available]
+    if isinstance(gpu_groups, (str, bytes)) or not isinstance(gpu_groups, Sequence):
+        raise TypeError("MULTIRUN.gpu_groups must be a list of GPU-id lists.")
+    if len(gpu_groups) == 0:
+        raise ValueError("MULTIRUN.gpu_groups cannot be empty.")
+
+    launches = []
+    used = set()
+    for group_index, raw_group in enumerate(gpu_groups):
+        if isinstance(raw_group, (str, bytes)) or not isinstance(raw_group, Sequence):
+            raise TypeError(f"gpu_groups[{group_index}] must be a list of GPU ids.")
+        if len(raw_group) == 0:
+            raise ValueError(f"gpu_groups[{group_index}] cannot be empty.")
+        if len(raw_group) != 4:
+            raise ValueError(
+                f"gpu_groups[{group_index}] has {len(raw_group)} GPUs; the current "
+                "FastWAM placement requires exactly four."
+            )
+
+        group = []
+        for raw_gpu in raw_group:
+            if isinstance(raw_gpu, bool):
+                raise TypeError("GPU identifiers must be non-negative integers, not bool.")
+            if isinstance(raw_gpu, int):
+                gpu_id = str(raw_gpu)
+            elif isinstance(raw_gpu, str) and raw_gpu.strip().isdigit():
+                gpu_id = str(int(raw_gpu.strip()))
+            else:
+                raise TypeError(
+                    f"Invalid GPU identifier {raw_gpu!r}; expected a non-negative integer."
+                )
+            if gpu_id not in available:
+                raise ValueError(
+                    f"GPU {gpu_id} in gpu_groups[{group_index}] is outside the "
+                    f"available set {available}."
+                )
+            if gpu_id in used:
+                raise ValueError(f"GPU {gpu_id} appears in more than one worker group.")
+            used.add(gpu_id)
+            group.append(gpu_id)
+        launches.append(WorkerLaunch(tuple(group)))
+    return launches
