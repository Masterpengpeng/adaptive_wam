+import unittest
+
+from experiments.libero.worker_launch import resolve_worker_launches
+
+
+class WorkerLaunchTest(unittest.TestCase):
+    def test_default_preserves_one_worker_per_visible_gpu(self):
+        launches = resolve_worker_launches(
+            num_gpus=2,
+            gpu_groups=None,
+            cuda_visible_devices="4,7,9",
+        )
+
+        self.assertEqual([launch.physical_gpus for launch in launches], [("4",), ("7",)])
+        self.assertEqual([launch.worker_id for launch in launches], ["4", "7"])
+        self.assertEqual([launch.component_overrides for launch in launches], [(), ()])
+
+    def test_explicit_groups_map_physical_to_logical_component_devices(self):
+        launches = resolve_worker_launches(
+            num_gpus=8,
+            gpu_groups=[[0, 1, 2, 3], [4, 5, 6, 7]],
+            cuda_visible_devices=None,
+        )
+
+        self.assertEqual(
+            [launch.cuda_visible_devices for launch in launches],
+            ["0,1,2,3", "4,5,6,7"],
+        )
+        command = launches[0].build_command(
+            python_executable="python",
+            config_name="sim_libero",
+            task_choice="task_config",
+            ckpt="checkpoint",
+            num_trials=3,
+            output_dir="results",
+            extra_overrides=["seed=7", "EVALUATION.compile_action_infer=false"],
+        )
+        self.assertIn("gpu_id=0", command)
+        self.assertIn("seed=7", command)
+        self.assertIn("EVALUATION.device=cuda:0", command)
+        self.assertIn("EVALUATION.video_device=cuda:0", command)
+        self.assertIn("EVALUATION.action_device=cuda:1", command)
+        self.assertIn("EVALUATION.vae_device=cuda:1", command)
+        self.assertIn("EVALUATION.text_encoder_devices=[cuda:2,cuda:3]", command)
+        self.assertEqual(command.count("EVALUATION.compile_action_infer=false"), 1)
+
+    def test_environment_records_physical_group_and_preserves_base(self):
+        launch = resolve_worker_launches(
+            num_gpus=4,
+            gpu_groups=[[0, 1, 2, 3]],
+            cuda_visible_devices=None,
+        )[0]
+        environment = launch.build_environment(
+            base_environment={"PATH": "/bin", "CUDA_VISIBLE_DEVICES": "old"},
+            pending_file="pending",
+            lock_file="lock",
+            stop_file="stop",
+            status_dir="status",
+            failed_file="failed",
+        )
+
+        self.assertEqual(environment["PATH"], "/bin")
+        self.assertEqual(environment["CUDA_VISIBLE_DEVICES"], "0,1,2,3")
+        self.assertEqual(environment["LIBERO_WORKER_ID"], "group_0-1-2-3")
+        self.assertEqual(environment["LIBERO_WORKER_PHYSICAL_GPUS"], "0,1,2,3")
