+import logging
+import sys
+import types
+import unittest
+from unittest.mock import patch
+
+import torch
+import torch.nn as nn
+
+
+def _install_lightweight_import_stubs() -> None:
+    einops = types.ModuleType("einops")
+    einops.rearrange = lambda value, *_args, **_kwargs: value
+    einops.repeat = lambda value, *_args, **_kwargs: value
+    sys.modules.setdefault("einops", einops)
+
+    logging_config = types.ModuleType("fastwam.utils.logging_config")
+    logging_config.get_logger = logging.getLogger
+    logging_config.setup_logging = lambda *_args, **_kwargs: None
+    sys.modules["fastwam.utils.logging_config"] = logging_config
+
+    loader = types.ModuleType("fastwam.models.wan22.helpers.loader")
+    loader.load_wan22_ti2v_5b_components = lambda **_kwargs: None
+    sys.modules["fastwam.models.wan22.helpers.loader"] = loader
+
+    transformers = types.ModuleType("transformers")
+    transformers.AutoTokenizer = object
+    sys.modules.setdefault("transformers", transformers)
+
+
+_install_lightweight_import_stubs()
+
+from fastwam.models.wan22.device_placement import (  # noqa: E402
+    move_tensor_sequence,
+    reject_unsupported_multidevice_path,
+    require_multidevice_eager,
+    resolve_component_devices,
+)
+from fastwam.models.wan22.fastwam import FastWAM  # noqa: E402
+from fastwam.models.wan22.fastwam_joint import FastWAMJoint  # noqa: E402
+from fastwam.models.wan22.fastwam_idm import FastWAMIDM  # noqa: E402
+from fastwam.models.wan22.fastwam_optional_idm import FastWAMOptionalIDM  # noqa: E402
+from fastwam.models.wan22.wan_video_text_encoder import WanTextEncoder  # noqa: E402
+
+
+class _CountingTextEncoder(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.calls = 0
+
+    def forward(self, ids, mask):
+        self.calls += 1
+        return ids.to(torch.float32).unsqueeze(-1).expand(-1, -1, 4).clone()
+
+
+class _Tokenizer:
+    def __call__(self, _prompt, **_kwargs):
+        return torch.tensor([[1, 2, 0]]), torch.tensor([[1, 1, 0]])
+
+
+def _bare_fastwam(cls=FastWAM, *, multi_device: bool):
+    model = cls.__new__(cls)
+    nn.Module.__init__(model)
+    model.is_multi_device = multi_device
+    model.mot = nn.Identity()
+    model.vae = nn.Identity()
+    model.text_encoder = None
+    model._text_encoder_offloaded = False
+    return model
+
+
+class ComponentPlacementTest(unittest.TestCase):
+    def test_single_device_defaults_are_backward_compatible(self):
+        placement = resolve_component_devices("cpu")
+        self.assertFalse(placement.is_multi_device)
+        self.assertEqual(placement.video, torch.device("cpu"))
+        self.assertEqual(placement.action, torch.device("cpu"))
+        self.assertEqual(placement.vae, torch.device("cpu"))
+        self.assertEqual(placement.text, (torch.device("cpu"),))
+
+        model = _bare_fastwam(multi_device=False)
+        self.assertIs(model.to("cpu"), model)
+
+    def test_explicit_component_devices_enable_multidevice_mode(self):
+        placement = resolve_component_devices(
+            "cpu", video_device="meta", action_device="cpu", vae_device="cpu"
+        )
+        self.assertTrue(placement.is_multi_device)
+        self.assertEqual(placement.video, torch.device("meta"))
+
+    def test_text_partition_config_is_explicit_and_unambiguous(self):
+        placement = resolve_component_devices(
+            "cpu", text_encoder_devices=["cuda:2", "cuda:3"]
+        )
+        self.assertEqual(
+            placement.text, (torch.device("cuda:2"), torch.device("cuda:3"))
+        )
+        with self.assertRaisesRegex(ValueError, "only one"):
+            resolve_component_devices(
+                "cpu",
+                text_encoder_device="cuda:2",
+                text_encoder_devices=["cuda:2", "cuda:3"],
+            )
+        with self.assertRaisesRegex(ValueError, "exactly two"):
+            resolve_component_devices("cpu", text_encoder_devices=["cuda:2"])
+
+    def test_blanket_to_is_rejected_for_multidevice_model(self):
+        model = _bare_fastwam(multi_device=True)
+        with self.assertRaisesRegex(RuntimeError, "whole-model"):
+            model.to("cpu")
+
+    def test_kv_sequence_moves_to_consumer_device(self):
+        source = [torch.ones(2), torch.zeros(3)]
+        moved = move_tensor_sequence(source, "meta")
+        self.assertEqual([item.device.type for item in moved], ["meta", "meta"])
+        self.assertEqual([tuple(item.shape) for item in moved], [(2,), (3,)])
+
+    def test_compile_guard_applies_only_to_multidevice(self):
+        require_multidevice_eager(
+            is_multi_device=False, compile_action_infer=True
+        )
+        with self.assertRaisesRegex(ValueError, "compile_action_infer=False"):
+            require_multidevice_eager(
+                is_multi_device=True, compile_action_infer=True
+            )
+
+    def test_unsupported_multidevice_path_is_explicit(self):
+        with self.assertRaisesRegex(NotImplementedError, "first_frame"):
+            reject_unsupported_multidevice_path(
+                is_multi_device=True, path="FastWAMJoint.infer_action"
+            )
+
+
+class PromptCacheAndModeTest(unittest.TestCase):
+    def test_prompt_cache_reuses_encoder_output(self):
+        model = _bare_fastwam(multi_device=False)
+        model.device = torch.device("cpu")
+        model.action_device = torch.device("cpu")
+        model.text_encoder_device = torch.device("cpu")
+        model.torch_dtype = torch.float32
+        model.tokenizer = _Tokenizer()
+        model.text_encoder = _CountingTextEncoder()
+        model._prompt_context_cache = {}
+        model.text_encoder_devices = (torch.device("cpu"),)
+
+        first = model.encode_prompt("pick the cup")
+        second = model.encode_prompt("pick the cup")
+
+        self.assertEqual(model.text_encoder.calls, 1)
+        self.assertTrue(torch.equal(first[0], second[0]))
+        self.assertTrue(torch.equal(first[1], second[1]))
+        self.assertEqual(first[0].device.type, "cpu")
+
+    def test_preencode_then_offload_allows_hits_and_rejects_misses(self):
+        model = _bare_fastwam(multi_device=False)
+        model.device = torch.device("cpu")
+        model.action_device = torch.device("cpu")
+        model.text_encoder_device = torch.device("cpu")
+        model.text_encoder_devices = (torch.device("cpu"),)
+        model.torch_dtype = torch.float32
+        model.tokenizer = _Tokenizer()
+        model.text_encoder = _CountingTextEncoder()
+        model._prompt_context_cache = {}
+
+        model.preencode_prompts(["task a", "task a"], offload_text_encoder=True)
+        self.assertTrue(model._text_encoder_offloaded)
+        self.assertEqual(model.text_encoder.calls, 1)
+        model.encode_prompt("task a")
+        with self.assertRaisesRegex(RuntimeError, "cache miss"):
+            model.encode_prompt("task b")
+
+    def test_base_multidevice_compile_guard_fires_before_tensor_work(self):
+        model = _bare_fastwam(multi_device=True)
+        with self.assertRaisesRegex(ValueError, "compile_action_infer=False"):
+            model.infer_action(
+                prompt=None,
+                input_image=None,
+                action_horizon=1,
+                compile_action_infer=True,
+            )
+
+
+class WanTextEncoderPartitionTest(unittest.TestCase):
+    @staticmethod
+    def _tiny_encoder(*, shared_pos=False):
+        return WanTextEncoder(
+            vocab=16,
+            dim=4,
+            dim_attn=4,
+            dim_ffn=8,
+            num_heads=2,
+            num_layers=2,
+            num_buckets=4,
+            shared_pos=shared_pos,
+            dropout=0.0,
+        )
+
+    def test_official_unshared_position_structure_is_accepted(self):
+        encoder = self._tiny_encoder(shared_pos=False)
+        encoder.validate_partition_structure()
+        devices = encoder.validate_partition_devices(["cuda:2", "cuda:3"])
+        self.assertEqual(devices, (torch.device("cuda:2"), torch.device("cuda:3")))
+
+    def test_shared_position_structure_is_rejected(self):
+        encoder = self._tiny_encoder(shared_pos=True)
+        with self.assertRaisesRegex(ValueError, "shared_pos=False"):
+            encoder.validate_partition_structure()
+
+    def test_partition_requires_two_distinct_cuda_devices(self):
+        encoder = self._tiny_encoder()
+        with self.assertRaisesRegex(ValueError, "distinct"):
+            encoder.validate_partition_devices(["cuda:2", "cuda:2"])
+        with self.assertRaisesRegex(ValueError, "CUDA-only"):
+            encoder.validate_partition_devices(["cpu", "cuda:2"])
+
+    def test_joint_multidevice_path_fails_fast(self):
+        model = _bare_fastwam(FastWAMJoint, multi_device=True)
+        with self.assertRaisesRegex(NotImplementedError, "first_frame"):
+            model.infer_action(
+                prompt=None,
+                input_image=None,
+                action_horizon=1,
+                num_video_frames=1,
+            )
+
+    def test_optional_idm_routes_multidevice_idm_and_uses_base_guard(self):
+        model = _bare_fastwam(FastWAMOptionalIDM, multi_device=True)
