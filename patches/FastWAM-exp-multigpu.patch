+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Iterable, Sequence
+
+import torch
+
+
+@dataclass(frozen=True)
+class ComponentDevices:
+    default: torch.device
+    video: torch.device
+    action: torch.device
+    vae: torch.device
+    text: tuple[torch.device, ...]
+
+    @property
+    def is_multi_device(self) -> bool:
+        return len({self.video, self.action, self.vae, *self.text}) > 1
+
+
+def resolve_component_devices(
+    device: str | torch.device,
+    *,
+    video_device: str | torch.device | None = None,
+    action_device: str | torch.device | None = None,
+    vae_device: str | torch.device | None = None,
+    text_encoder_device: str | torch.device | None = None,
+    text_encoder_devices: Sequence[str | torch.device] | None = None,
+) -> ComponentDevices:
+    default = torch.device(device)
+    if text_encoder_device is not None and text_encoder_devices is not None:
+        raise ValueError(
+            "Set only one of `text_encoder_device` and `text_encoder_devices`."
+        )
+    if text_encoder_devices is None:
+        text = (torch.device(text_encoder_device or default),)
+    else:
+        text = tuple(torch.device(item) for item in text_encoder_devices)
+        if len(text) != 2:
+            raise ValueError(
+                "`text_encoder_devices` is the two-way partition option and must "
+                "contain exactly two devices; use `text_encoder_device` for one."
+            )
+        if text[0] == text[1]:
+            raise ValueError("Two-way T5 partitioning requires two distinct devices.")
+
+    return ComponentDevices(
+        default=default,
+        video=torch.device(video_device or default),
+        action=torch.device(action_device or default),
+        vae=torch.device(vae_device or default),
+        text=text,
+    )
+
+
+def move_tensor_sequence(
+    tensors: Iterable[torch.Tensor],
+    device: str | torch.device,
+    *,
+    non_blocking: bool = True,
+) -> list[torch.Tensor]:
+    target = torch.device(device)
+    return [tensor.to(device=target, non_blocking=non_blocking) for tensor in tensors]
+
+
+def require_multidevice_eager(
+    *, is_multi_device: bool, compile_action_infer: bool
+) -> None:
+    if is_multi_device and compile_action_infer:
+        raise ValueError(
+            "Multi-device first-frame inference requires "
+            "`compile_action_infer=False`."
+        )
+
+
+def reject_unsupported_multidevice_path(
+    *, is_multi_device: bool, path: str
+) -> None:
+    if is_multi_device:
+        raise NotImplementedError(
+            f"Multi-device `{path}` is not implemented. This adapter supports only "
+            "FastWAM base and FastWAMOptionalIDM action_infer_mode='first_frame'."
+        )
