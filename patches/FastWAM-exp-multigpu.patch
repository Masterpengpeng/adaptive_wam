+                num_video_frames=5,
+                action_infer_mode="idm",
+            )
+        infer_idm.assert_called_once()
+        with self.assertRaisesRegex(ValueError, "compile_action_infer=False"):
+            model.infer_action(
+                prompt=None,
+                input_image=None,
+                action_horizon=1,
+                num_video_frames=1,
+                action_infer_mode="first_frame",
+                compile_action_infer=True,
+            )
+
+
+if __name__ == "__main__":
