+def _synchronize_cuda_devices() -> None:
+    if not torch.cuda.is_available():
+        return
+    for device_idx in range(torch.cuda.device_count()):
+        torch.cuda.synchronize(device_idx)
+
+
+def _gpu_peak_memory() -> dict[str, dict[str, int | str]]:
+    peaks: dict[str, dict[str, int | str]] = {}
+    if not torch.cuda.is_available():
+        return peaks
+    for device_idx in range(torch.cuda.device_count()):
+        props = torch.cuda.get_device_properties(device_idx)
+        peaks[f"cuda:{device_idx}"] = {
+            "name": props.name,
+            "peak_allocated_bytes": int(torch.cuda.max_memory_allocated(device_idx)),
+            "peak_reserved_bytes": int(torch.cuda.max_memory_reserved(device_idx)),
+        }
+    return peaks
+
+
+def _latency_summary(latencies_seconds: list[float]) -> dict[str, float | int | None]:
+    if not latencies_seconds:
+        return {"count": 0, "mean_ms": None, "p50_ms": None, "p95_ms": None}
+    values_ms = np.asarray(latencies_seconds, dtype=np.float64) * 1000.0
+    return {
+        "count": int(values_ms.size),
+        "mean_ms": float(np.mean(values_ms)),
+        "p50_ms": float(np.percentile(values_ms, 50)),
+        "p95_ms": float(np.percentile(values_ms, 95)),
+    }
