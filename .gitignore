# Checkpoints and datasets
checkpoints/*
!checkpoints/.gitkeep
data/*
!data/.gitkeep

# Experiment outputs and runtime logs
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep

# Third-party repositories are pinned by adjacent lock files
repos/*
!repos/.gitkeep
!repos/*.lock

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.conda/
.runtime/

# IDE
.vscode/
.idea/

# Miscellaneous
*.log
.DS_Store

# Pytest
.pytest_cache/
